# Copy this file to .env and fill in real values. Never commit .env.

# --- Telegram ---
# Get from @BotFather (see README "Getting a Telegram bot token" section).
TELEGRAM_BOT_TOKEN=

# --- Model provider ---
# "anthropic" (default) calls the Anthropic API directly. "bedrock" routes
# through Amazon Bedrock instead — requires COS_AWS_REGION below, and a
# Bedrock-shaped COS_MODEL_ID (see note below), not an Anthropic API key.
COS_MODEL_PROVIDER=anthropic
# Only required when COS_MODEL_PROVIDER=anthropic.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model id to use.
# - anthropic provider: a bare Anthropic model name, e.g. "claude-haiku-4-5".
# - bedrock provider: a Bedrock model id or cross-region inference profile,
#   e.g. "eu.anthropic.claude-haiku-4-5-20251001-v1:0" for Frankfurt. Claude
#   models in EU regions require an inference profile, not the base model id
#   (Bedrock returns a ValidationException otherwise) — find the right one
#   with: aws bedrock list-inference-profiles --region <region>.
COS_MODEL_ID=claude-haiku-4-5

# --- Storage ---
# SQLite file path — the local/dev persistence choice (see README "Design
# decisions worth knowing"), not a placeholder for a future Sheets swap.
COS_DB_PATH=data/cos.db

# --- Persistence backend ---
# "sqlite" (default) for local dev. "dynamodb" is the deployed path's
# backend — built, covered by moto-based tests, and live-verified against a
# real table (see README "Status").
COS_PERSISTENCE_BACKEND=sqlite
# Only read when COS_PERSISTENCE_BACKEND=dynamodb.
COS_DYNAMODB_TABLE=cos_tasks
# Shared by both COS_MODEL_PROVIDER=bedrock and COS_PERSISTENCE_BACKEND=dynamodb.
# Required if either is set. e.g. eu-central-1.
COS_AWS_REGION=
# Optional named AWS CLI profile (from `aws configure --profile <name>`) to
# use instead of the default credential chain. Handy for local dev; leave
# unset in production (e.g. AgentCore's attached IAM role).
COS_AWS_PROFILE=

# --- Web search (cos/tools/search_tool.py) ---
# Optional — web_search degrades to "not connected" when unset, same as
# calendar below. https://app.tavily.com
TAVILY_API_KEY=

# --- Amazon product search (cos/tools/amazon_tool.py) ---
# Optional — search_amazon_products degrades to "not connected" when unset,
# same as TAVILY_API_KEY above. Finds/compares products and returns links
# only; never purchases anything. Free tier: 250 searches/month, no card
# required. https://serpapi.com
SERPAPI_API_KEY=

# --- Google Calendar (cos/tools/calendar_tool.py) ---
# Optional — all three only meaningful together; calendar_tool degrades to
# "not connected" unless all three are set. See README "Google Calendar
# setup" for how to get these, and run scripts/authorize_google_calendar.py
# once to obtain GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Gateway/brain mode ---
# "local" (default) runs the Strands Agent in-process, same as before the
# gateway/brain split. "agentcore" instead fires each instruction at a
# deployed Bedrock AgentCore Runtime endpoint — the deployed container sends
# the Telegram reply itself. Only read when COS_AGENT_MODE=agentcore.
COS_AGENT_MODE=local
COS_AGENTCORE_RUNTIME_ARN=

# --- Household config ---
# Path to the JSON file mapping this chat's Telegram user ids to partner names.
# See household.example.json for the format.
COS_HOUSEHOLD_CONFIG=household.json

# --- Daily nudge scheduler ---
# Local hour (0-23) the daily overdue/due-soon nudge check runs at.
COS_NUDGE_HOUR=9
# IANA timezone name (e.g. Europe/Istanbul) the hour above is in. Leave unset
# to use the machine/server's own local timezone.
COS_TIMEZONE=

# --- Weekly metrics scheduler ---
# Local hour (0-23) the weekly stats summary posts at.
COS_METRICS_HOUR=10
# Minute (0-59) within that hour. Defaults to 0 (top of the hour); mainly useful
# for pointing at a near-term time when testing.
COS_METRICS_MINUTE=0
# Day of week it posts on: 0=Sunday, 1=Monday, ... 6=Saturday (python-telegram-bot's
# JobQueue convention). Defaults to Sunday, matching the original spec's digest cadence.
COS_METRICS_WEEKDAY=0

# --- Web dashboard (src/cos/webapp — only used by `python -m cos.webapp`,
# not by the bot itself; requires the "webapp" extra: pip install -e ".[webapp]") ---
# Shared login password for the dashboard. Required.
COS_WEBAPP_PASSWORD=
# Random signing key for the session cookie — generate a real one, don't
# reuse this file's placeholder: python -c "import secrets; print(secrets.token_urlsafe(32))"
COS_WEBAPP_SESSION_SECRET=
# ECS cluster/service names for the "bot status" panel's describe/restart
# calls — see deploy/gateway/README.md. Defaults match that doc's naming.
COS_ECS_CLUSTER=cos-cluster
COS_ECS_SERVICE=cos-gateway
