{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "AssumeRolePolicy",
    "Effect": "Allow",
    "Principal": { "Service": "bedrock-agentcore.amazonaws.com" },
    "Action": "sts:AssumeRole",
    "Condition": {
      "StringEquals": { "aws:SourceAccount": "345896303484" },
      "ArnLike": { "aws:SourceArn": "arn:aws:bedrock-agentcore:eu-central-1:345896303484:*" }
    }
  }]
}
